# Copiar a .env.local y completar (NUNCA commitear valores reales).
# Supabase: dashboard del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=cambia-esto-en-produccion

# Email: SMTP gana si está completo; si no, Resend; si no, nada (sin romper).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=tu-correo@gmail.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Reservas <noreply@tudominio.com>

# Sentry (opcional hasta tener DSN)
SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ

# Demo (solo local): muestra botones de cuentas prueba en /login.
# NO activar en producción.
NEXT_PUBLIC_DEMO_ACCOUNTS=true
